# Copiez ce fichier en .env puis remplissez les valeurs
SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire
APP_URL=http://localhost:5000

# PostgreSQL (laisser vide = SQLite local pour tester rapidement)
# DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/talentconnect

# Compte administrateur créé au premier lancement
ADMIN_EMAIL=admin@talentconnect.app
ADMIN_PASSWORD=ChangezMoi123!

# E-mails via Brevo (gratuit : 300 e-mails/jour) — Brevo > SMTP & API > SMTP
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=TalentConnect <no-reply@votre-domaine.com>

# IA générative (facultatif) — https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

DEFAULT_LANGUAGE=fr
DEFAULT_COUNTRY=CI
