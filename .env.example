# Copiez ce fichier en .env puis remplissez les valeurs
SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire
APP_URL=http://localhost:5000

# PostgreSQL (laisser vide = SQLite local pour tester rapidement)
# DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/talentconnect

# Offres externes en temps réel (API officielles, facultatif)
# JSearch agrège Google for Jobs : annonces LinkedIn, Indeed, Glassdoor, Welcome to the Jungle…
# Clé gratuite (200 recherches/mois) sur https://www.openwebninja.com/api/jsearch
JSEARCH_API_KEY=
# JSEARCH_FOURNISSEUR=rapidapi   # seulement si la clé vient de RapidAPI
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Compte administrateur créé au premier lancement
ADMIN_EMAIL=admin@talentconnect.app
ADMIN_PASSWORD=ChangezMoi123!

# E-mails via Brevo (gratuit : 300 e-mails/jour) — Brevo > SMTP & API > SMTP
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=TalentConnect <no-reply@votre-domaine.com>

# IA générative (facultatif)
# OpenRouter : un compte, des dizaines de modèles dont beaucoup gratuits — https://openrouter.ai/keys
# Si un modèle est saturé, l'app passe toute seule au modèle gratuit suivant.
OPENROUTER_API_KEY=
# Modèles à essayer en premier (facultatif), ex. : deepseek/deepseek-chat-v3-0324:free,meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODELES=
# Ou Claude directement — https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

DEFAULT_LANGUAGE=fr
DEFAULT_COUNTRY=CI
